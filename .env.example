# Copy to .env and fill in. .env is git-ignored — never commit real credentials.
# Standard Postgres URL (parsed by the app for the pg8000 driver):
DATABASE_URL=postgresql://bms_app:CHANGE_ME@127.0.0.1:5432/bms
# Optional least-privilege read-only role (used by the query builder). Falls back
# to DATABASE_URL if unset. Create it with sql/roles.sql.
READONLY_DATABASE_URL=postgresql://bms_readonly:CHANGE_ME@127.0.0.1:5432/bms
# Secret used to sign auth session tokens (JWT). Use a long random string in prod.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# FAU Trussed.ai (OpenAI-compatible LLM) for the AI features. Server-side only.
TRUSSED_API_KEY=CHANGE_ME_FAU_TRUSSED_KEY
# Optional overrides:
# TRUSSED_MODEL=gpt-5.4
# TRUSSED_BASE_URL=https://fauengtrussed.fau.edu/provider/generic

# Deploy-only (set on the host, not needed for local dev — see docs/DEPLOY.md):
# RUN_SIMULATOR=1        # run the telemetry simulator inside the web service
# SIM_FLEET=30           # fleet size for that in-process simulator
# STATIC_DIR=...         # path to the built frontend (Docker sets this)
# DB_SSL=1               # force TLS to Postgres (or use ?sslmode=require in the URL)
